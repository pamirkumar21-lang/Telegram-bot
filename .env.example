# Telegram bot token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. Example: 123456789,987654321
ADMIN_IDS=
# Channel username (e.g. @KDramaHubUpdates) or numeric chat ID used for file storage/announcements
STORAGE_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
# Optional force-subscribe channel, e.g. @KDramaHubUpdates
FORCE_SUBSCRIBE_CHANNEL=
# Firebase Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
# Base64-encoded service account JSON. Generate locally; do not share it.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Must be a long random string; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
SETUP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# Optional public webhook base URL without trailing slash, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=
# Optional timezone for reports (IANA format). Default Asia/Kolkata
REPORT_TIMEZONE=Asia/Kolkata
# Optional comma-separated admin IDs allowed to receive error alerts; defaults to ADMIN_IDS
ERROR_ALERT_ADMIN_IDS=
